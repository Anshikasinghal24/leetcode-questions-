class Solution {
public:
    int lastRemaining(int n) {
        int first = 1;
        int gap = 1;
        int count = n;
        bool leftToRight = true;

        while (count > 1) {
            if (leftToRight || count % 2 == 1) {
                first = first + gap;
            }
            count = count / 2;
            gap = gap * 2;
            leftToRight = !leftToRight;
        }
        return first;
    }
};
